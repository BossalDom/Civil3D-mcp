{
  "name": "civil3d-mcp",
  "version": "1.0.0",
  "description": "MCP server for interacting with Autodesk Civil 3D.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "civil3d-mcp": "./build/index.js"
  },
  "scripts": {
    "clean": "rimraf build",
    "prebuild": "npm run clean",
    "build": "tsc && node ./scripts/copy-static-assets.mjs",
    "start": "node ./build/index.js",
    "test": "vitest run",
    "test:p2-boundaries": "dotnet run --project ./tests/FileBoundaryHarness/FileBoundaryHarness.csproj",
    "test:watch": "vitest",
    "test:live-plugin": "npm run build && node ./scripts/verify-live-plugin.mjs",
    "claude:add": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-claude-mcp.ps1 -Scope project",
    "claude:add:user": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-claude-mcp.ps1 -Scope user",
    "claude:print-add": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-claude-mcp.ps1 -Scope project -PrintOnly"
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sacred-G/Civil3D-mcp.git"
  },
  "keywords": [],
  "author": "Steven Bouldin",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Sacred-G/Civil3D-mcp/issues"
  },
  "homepage": "https://github.com/Sacred-G/Civil3D-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "rimraf": "^5.0.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0"
  }
}
